# Copy to .env for local development. Never commit .env.

# Core
RAGMED_ENVIRONMENT=local          # local | ci | production
RAGMED_SERVICE_NAME=ragmed
RAGMED_LOG_LEVEL=INFO
# RAGMED_LOG_JSON=true            # defaults to true outside local

# Encrypts credentials users give us (their database and MCP server keys). Needed from the
# connections feature on. Generate one with:
#   python -c "from ragmed_core.secrets import generate_master_key as g; print(g())"
# RAGMED_MASTER_KEY=

# Care Coordinator: saved conversations and shared rate limits. Without them, both stay in
# memory. `make infra-up` starts local ones at these addresses.
# RAGMED_DATABASE_URL=postgresql://ragmed:ragmed-local-only@127.0.0.1:5432/ragmed
# RAGMED_VALKEY_URL=redis://127.0.0.1:6379/0

# Booking verification codes are emailed from this account. Gmail works for free (about 500
# emails a day): turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords, and use it here (not the account password).
# Without these, local runs write the code to the Coordinator's log instead.
# RAGMED_SMTP_USERNAME=ragmedclinic@gmail.com
# RAGMED_SMTP_PASSWORD=
# RAGMED_SMTP_HOST=smtp.gmail.com
# RAGMED_SMTP_PORT=587

# Backup models (Gemini) for when Groq's free tier is busy. Free key, no card:
# https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
