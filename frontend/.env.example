# Copy to .env.local for local development. Server-side only: never sent to the browser.
COORDINATOR_URL=http://127.0.0.1:8000
# Needed when the Coordinator requires a token (always in production).
# COORDINATOR_TOKEN=

# Clinician view (/clinician): the code clinicians type, and the Scheduling server's token.
# SCHEDULING_URL=http://127.0.0.1:9002
# CLINICIAN_ACCESS_CODE=
# CLINICIAN_TOKEN=
# Time zone appointment times are shown in.
# NEXT_PUBLIC_CLINIC_TIME_ZONE=America/St_Johns

# Bot check (Cloudflare Turnstile). Without a secret the check is off (local development only).
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Signs the session cookie set after the check: at least 32 random characters.
# SESSION_SECRET=
